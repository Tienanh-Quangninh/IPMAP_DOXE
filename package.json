{
  "name": "racing-garage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "pages:dev": "npm run build && wrangler pages dev dist",
    "test": "tsx --test tests/*.test.ts",
    "check:pages": "wrangler pages functions build --outdir .cloudflare-build",
    "test:ui": "node scripts/verify-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "social:image": "node scripts/generate-social.mjs",
    "check:seo": "node scripts/verify-seo.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
